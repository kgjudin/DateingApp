# VYBE Production & Development Environment Configuration

# Server
PORT=5000
NODE_ENV=development
API_PREFIX=/api/v1
CORS_ORIGIN=*

# Supabase Credentials
# Found in Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
JWT_SECRET=super-secret-vybe-jwt-key-change-in-production

# Agora RTC Configuration
# Found in Agora Console -> Project Management
AGORA_APP_ID=your-agora-app-id
AGORA_APP_CERTIFICATE=your-agora-app-certificate
AGORA_TOKEN_EXPIRATION_SECONDS=86400

# Firebase Cloud Messaging (Push Notifications)
FIREBASE_PROJECT_ID=vybe-social
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@vybe-social.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Admin Configuration
ADMIN_SECRET_KEY=vybe-superadmin-secure-passcode
